{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies"],
  "timezone": "Europe/Madrid",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Batch routine minor and patch updates into one weekly PR",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "minor and patch updates"
    },
    {
      "description": "Keep Node, pnpm and core tooling in their own PRs so runtime changes stay visible",
      "matchDepNames": ["node", "pnpm", "vite", "vitest", "typescript"],
      "groupName": null
    }
  ]
}
